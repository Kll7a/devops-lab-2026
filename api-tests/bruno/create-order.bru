meta {
  name: create order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

body:json {
  {
    "item": "book",
    "qty": 2
  }
}

script:post-response {
  bru.setVar("orderId", res.body.id);
}

tests {
  test("создание возвращает 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("статус нового заказа = NEW", function() {
    expect(res.body.status).to.equal("NEW");
  });
}
